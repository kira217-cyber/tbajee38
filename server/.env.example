# সার্ভার
PORT=5000
NODE_ENV=development

# ডেটাবেস
MONGO_URI=mongodb://<user>:<password>@<host>:27017/tbajee38?authSource=admin

# JWT — এই সিক্রেটটা এই ইনস্টলেশনের জন্য তৈরি করা, শেয়ার করবেন না
JWT_SECRET=<৬৪ অক্ষরের র‍্যান্ডম স্ট্রিং — `openssl rand -hex 32`>
JWT_EXPIRE=7d

# CORS — খালি রাখলে সব অরিজিন allowed (API টোকেন-ভিত্তিক, কুকি নয়)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
